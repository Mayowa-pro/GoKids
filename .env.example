# Copy to .env.local for local development.

# Database: a local SQLite file by default. In production use Turso (libsql://your-db.turso.io).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Password for /admin, where you approve submissions and feature events. At least 8 characters.
ADMIN_PASSWORD=change-me-please

# Public URL, used in the sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a different map tile server (defaults to CARTO Voyager, which needs attribution).
# NEXT_PUBLIC_MAP_TILES=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
